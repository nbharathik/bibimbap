{
  "questions_csv": "data/prompts/basic_tasks.csv",
  "num_samples": 1,
  "model_name": "openai:gpt-5-mini-2025-08-07",
  "system_prompt": "You are a BIM assistant. Execute tools as needed and return concise outputs.",
  "llm_agent_system": "llm_agents.code_execution_agent:CodeExecutionAgent",
  "agent": {
    "tool_timeout": 45,
    "force_subprocess": true
  },
  "paths": {
    "ifc_dir": "data/ifc",
    "tests_module": "data.tests",
    "structured_outputs_module": "data.structured_outputs",
    "results_dir": "results"
  },
  "results": {
    "cache_filename_template": "cache_{model_suffix}.json",
    "edited_ifc_dir_template": "edited_ifc_{model_suffix}"
  }
}
