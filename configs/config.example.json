{
  "version": "1.0.0",

  "claude": {
    "model": "claude-3-5-sonnet-20241022",
    "temperature": 0.1,
    "max_tokens": 4096
  },
  "ui": {
    "show_tools": true,
    "show_timing": true,
    "colored_output": true,
    "prompt_prefix": "BIM-CLI"
  },
  "mcp_servers": {
    "blender": {
      "name": "blender",
      "enabled": true,
      "transport": "stdio",
      "command": "python",
      "args": ["-m", "blender_mcp.server"],
      "cwd": "path/to/blender_mcp",
      "description": "Blender MCP server integration"
    }
  }
}
