{
  "questions_csv": "data/prompts/all_questions.csv",
  "num_samples": 1,
  "model_name": "anthropic:claude-3-7-sonnet-latest",
  "system_prompt": "You are a BIM assistent. Whenever you have questions about values, infer them or use default values. Always execute the commands and do not ask for confirmation. You must always load the ifc file first. For any operation, make sure to use the correct unit scale of the IFC file.",
  "llm_agent_system": "llm_agents.mcp_agent:MCPAgent",
  "agent": {
    "mcp_servers": {
      "ifc-bonsai-mcp": {
        "command": "python",
        "args": [
          "-m",
          "blender_mcp.server"
        ],
        "transport": "stdio"
      }
    }
  },
  "paths": {
    "ifc_dir": "data/ifc",
    "tests_module": "data.tests",
    "structured_outputs_module": "data.structured_outputs",
    "results_dir": "results"
  },
  "results": {
    "cache_filename_template": "cache_{model_suffix}.json",
    "edited_ifc_dir_template": "edited_ifc_{model_suffix}"
  }
}
